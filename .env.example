# Server-only permanent credential. Set locally, never paste into chat.
OPENAI_API_KEY=
# Exact public HTTPS origin for a hosted demo; blank keeps localhost-only access.
# Vercel production automatically uses VERCEL_PROJECT_PRODUCTION_URL if available.
# Set explicitly for a custom domain, Render, or disabled Vercel system variables.
# Example: APP_ORIGIN=https://your-app.vercel.app
APP_ORIGIN=
# Verified GA model; override with a Realtime model available to your account.
OPENAI_REALTIME_MODEL=gpt-realtime
OPENAI_REALTIME_VOICE=marin
# Server-side business prompt, read when each new Realtime session is created.
# Replace these examples with your full business prompt. Never put secrets here.
# Restart locally after editing; on Render save and deploy. End/start the conversation.
BUSINESS_NAME="Your business"
AGENT_GREETING="Hello! How can I help you today?"
# Quoted values can span multiple lines in .env.local. No source-code edit needed.
# Next.js expands $VARIABLE references in .env files; escape a literal dollar as \$.
# Application privacy, tool permissions, and truthful reporting remain separate in code.
AGENT_INSTRUCTIONS="You are the voice assistant for the configured business.
Help visitors understand its services using the knowledge search tool.
Use warm, plain language and keep spoken answers to two or three sentences.
Ask one clarification at a time when a question is ambiguous.
Use the caller's language when possible."
# Leave both blank for voice-only smoke testing. Base URL, no /search suffix.
RAG_WRAPPER_URL=
RAG_WRAPPER_API_KEY=
