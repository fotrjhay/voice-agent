# ── Voice / OpenAI — server-only ──
OPENAI_API_KEY=YOUR_EXISTING_OPENAI_KEY
OPENAI_REALTIME_MODEL=gpt-realtime
OPENAI_REALTIME_VOICE=marin

# ── Existing retrieval service — server-only ──
RAG_WRAPPER_URL=YOUR_EXISTING_WRAPPER_BASE_URL
RAG_WRAPPER_API_KEY=YOUR_EXISTING_WRAPPER_KEY

# ── Local application origins ──
VOICE_APP_ORIGIN=http://localhost:3000
ADMIN_APP_ORIGIN=http://localhost:3000

# Legacy fallback; may remain empty when the two origins above are set
APP_ORIGIN=

# Stable document/source identifier — do not change after uploading documents
BUSINESS_ID=primary

# ── Initial assistant defaults ──
# Used before the first saved database configuration.
# After that, edit settings through the dashboard.
BUSINESS_NAME="Your business"
AGENT_GREETING="Hello! How can I help you today?"
AGENT_TONE=friendly
SUPPORT_EMAIL=
SUPPORT_PHONE=
SUPPORT_URL=

AGENT_INSTRUCTIONS="You are the voice assistant for this business.
Use warm, clear language.
Keep spoken answers concise.
Ask for clarification when needed."

# ── Supabase Auth — public project identifiers ──
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=YOUR_SUPABASE_PUBLISHABLE_KEY

# ── Supabase PostgreSQL — server-only scoped application login ──
# Copy the actual pooler host from Supabase Connect.
# URL-encode special characters in the password.
ADMIN_DATABASE_URL="postgresql://voice_agent_login.YOUR_PROJECT_REF:URL_ENCODED_PASSWORD@YOUR_POOLER_HOST:6543/postgres"
ADMIN_DATABASE_TLS=verify

# Optional: provider CA certificate, only if required
ADMIN_DATABASE_CA=

# ── Dropbox App Folder — server-only ──
DROPBOX_APP_KEY=YOUR_DROPBOX_APP_KEY
DROPBOX_APP_SECRET=YOUR_DROPBOX_APP_SECRET
DROPBOX_REFRESH_TOKEN=YOUR_OFFLINE_REFRESH_TOKEN

# Path relative to this Dropbox app's folder
DROPBOX_UPLOAD_FOLDER=/documents

# Maximum 3 MiB; you may lower this value
DOCUMENT_MAX_UPLOAD_BYTES=3145728